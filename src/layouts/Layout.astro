---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloater from '../components/WhatsAppFloater.astro';
// 1. Importación del nuevo componente (Asegúrate de que el nombre del archivo coincida)
import ChatFlotante from '../components/ChatFlotante.astro';

interface Props {
    title: string;
    description: string;
    image?: string; 
}

const { title, description, image = '/images/LOGO.webp' } = Astro.props; 
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <script async src="https://www.googletagmanager.com/gtag/js?id=G-H2JJVE75F3" is:inline></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-H2JJVE75F3');

          document.addEventListener('astro:page-load', () => {
            gtag('config', 'G-H2JJVE75F3', {
              page_path: window.location.pathname,
            });
          });
        </script>

        <script is:inline>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '2039038839979376');
        fbq('track', 'PageView');

        // Registro de PageView para ClientRouter
        document.addEventListener('astro:page-load', () => {
          fbq('track', 'PageView');
        });
        </script>
        <noscript><img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=2039038839979376&ev=PageView&noscript=1"
        /></noscript>
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />

        <ClientRouter />
    </head>
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-16751651845"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-16751651845');
</script>
    
    <body class="bg-white text-gray-900">
        
        <Navbar />

        <div id="global-loader" class="hidden fixed inset-0 bg-white z-[9999] flex flex-col items-center justify-start overflow-hidden pointer-events-none">
            <div class="mt-24 mb-10 opacity-20">
                <img src="/images/LOGO.webp" alt="Cargando..." class="w-16 h-16 object-contain animate-pulse" />
            </div>
            
            <div class="max-w-7xl w-full px-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
                {[1, 2, 3].map(() => (
                    <div class="animate-pulse flex flex-col">
                        <div class="bg-gray-100 aspect-[4/3] rounded-[2.5rem] mb-8"></div>
                        <div class="h-3 bg-gray-100 rounded w-1/4 mb-6"></div>
                        <div class="h-8 bg-gray-100 rounded w-full mb-4"></div>
                        <div class="h-8 bg-gray-100 rounded w-2/3 mb-8"></div>
                    </div>
                ))}
            </div>
        </div>

        <main class="pt-20 min-h-screen content-wrapper">
            <slot /> 
        </main>

        <Footer />
        
        <div class="whatsapp-wrapper">
            <WhatsAppFloater />
        </div>

        <ChatFlotante />

        <script is:inline>
            // --- MANEJO DEL LOADER ---
            document.addEventListener('astro:before-preparation', (event) => {
                const loader = document.getElementById('global-loader');
                if (loader && event.to.pathname.includes('/blog')) {
                    loader.classList.remove('hidden');
                    loader.style.pointerEvents = 'auto'; 
                }
            });

            document.addEventListener('astro:page-load', () => {
                const loader = document.getElementById('global-loader');
                if (loader) {
                    loader.classList.add('hidden');
                    loader.style.pointerEvents = 'none';
                }
            });

            // --- ANIMACIÓN GLOBAL ADAPTADA PARA CLIENT ROUTER ---
            let scrollObserver;

            function setupScrollReveals() {
                // Desconectamos cualquier observador previo
                if (scrollObserver) scrollObserver.disconnect();

                // Damos un respiro de 50ms para que Astro pinte por completo el DOM de la nueva pestaña
                setTimeout(() => {
                    const elements = document.querySelectorAll('.reveal');
                    if (elements.length === 0) return;
                    
                    scrollObserver = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('reveal-active');
                                scrollObserver.unobserve(entry.target); 
                            }
                        });
                    }, {
                        threshold: 0.05, 
                        rootMargin: "0px 0px -20px 0px"
                    });

                    elements.forEach(el => scrollObserver.observe(el));
                }, 50);
            }

            // Escuchamos los eventos clave de transición de Astro
            document.addEventListener('astro:page-load', setupScrollReveals);
            document.addEventListener('astro:after-swap', setupScrollReveals);
        </script>

        <style is:global>
            /* Evitar desbordamientos fantasmas durante la transición de páginas */
            .content-wrapper {
                overflow: hidden;
            }

            /* --- SISTEMA GLOBAL DE APARIENCIA EN SCROLL --- */
            .reveal {
                opacity: 0;
                transform: scale(0.98); 
                transition: opacity 1s cubic-bezier(0.215, 0.610, 0.355, 1), 
                            transform 1s cubic-bezier(0.215, 0.610, 0.355, 1);
                will-change: opacity, transform;
            }

            /* Se activa automáticamente al hacer scroll o cambiar de pestaña */
            .reveal.reveal-active {
                opacity: 1;
                transform: scale(1);
            }

            /* Tiempos de retraso asignables mediante clases */
            .reveal.delay-1 { transition-delay: 0.15s; }
            .reveal.delay-2 { transition-delay: 0.3s; }
            .reveal.delay-3 { transition-delay: 0.45s; }

            /* Desactivar animaciones si el sistema operativo del usuario solicita reducción de movimiento */
            @media (prefers-reduced-motion: reduce) {
                .reveal {
                    opacity: 1 !important;
                    transform: none !important;
                    transition: none !important;
                }
            }

            /* --- ESTILOS COMPLEMENTARIOS --- */
            .whatsapp-wrapper {
                position: fixed;
                bottom: 0;
                right: 0;
                z-index: 99999;
                pointer-events: none;
            }
            .whatsapp-wrapper > * { pointer-events: auto; }
            html { scroll-behavior: smooth; }
        </style>
    </body>
</html>