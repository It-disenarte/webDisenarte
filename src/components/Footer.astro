---
/**
 * src/components/Footer.astro
 */
---

<footer class="bg-[#7C07A6] text-white py-16 border-t border-white/10" role="contentinfo">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-center">
      
      <div class="flex items-center justify-center">
        <a href="/" class="hover:opacity-80 transition-opacity" title="Volver al inicio">
          <img 
            src="/images/assets/LOGO-BLANCO.webp" 
            alt="Logotipo oficial" 
            class="h-24 md:h-32 w-auto object-contain" 
            loading="lazy"
          />
        </a>
      </div>

      <div class="footer-column-border">
        <div class="flex flex-col space-y-4">
          <h3 class="footer-title">CONTACTO</h3>
          <div class="contact-item">
            <img src="/images/assets/ICON-TELEFONO.webp" alt="" class="contact-icon" aria-hidden="true" />
            <a href="tel:4272110528" class="contact-link">427 211 05 28</a>
          </div>
          <div class="contact-item">
            <img src="/images/assets/whatsappb.webp" alt="" class="contact-icon" aria-hidden="true" />
            <a href="https://wa.me/524271004183" target="_blank" rel="noopener noreferrer" class="contact-link">427 100 41 83</a>
          </div>
          <div class="contact-item">
            <img src="/images/assets/ICON-CORREO.webp" alt="" class="contact-icon" aria-hidden="true" />
            <a href="mailto:ventas@disenartemx.com" class="contact-link">ventas@disenartemx.com</a>
          </div>
          <div class="flex items-start space-x-3 mt-4">
            <img src="/images/assets/ICON-UBI.webp" alt="" class="contact-icon mt-1" aria-hidden="true" />
            <address class="footer-address">
              Av. Lomas del Pedregoso #371<br />
              Col. Lomas de San Juan, Sección Campestre.<br />
              San Juan del Rio, Querétaro.
            </address>
          </div>
        </div>
      </div>

      <div class="footer-column-border flex flex-col justify-between">
        <div class="flex flex-col items-start space-y-6 w-full">
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#E6E7E8]">Síguenos</span>
          
          <!-- Contenedor con tamaño fijo para todos los botones -->
          <div class="flex flex-row gap-4 items-start">
            <a href="https://www.instagram.com/disenarte.mexico/" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
              <img src="/images/assets/INSTA.webp" alt="Instagram" />
            </a>
            <a href="https://www.facebook.com/Disenarte2mil" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Facebook">
              <img src="/images/assets/FACEBOOK.webp" alt="Facebook" />
            </a>
            <a href="https://www.youtube.com/@DiseñarteMéxico" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="YouTube">
              <img src="/images/assets/YOUTUBE.webp" alt="YouTube" />
            </a>
          </div>
        </div>
        
        <p class="text-[10px] text-[#E6E7E8]/50 uppercase tracking-widest mt-12 pt-8">
          © 2026 Diseñarte México
        </p>
      </div>

    </div>
  </div>
</footer>

<style>
  .footer-column-border { border-left-width: 0; padding-left: 0; }
  @media (min-width: 768px) {
    .footer-column-border { border-left-width: 1px; border-color: rgba(230, 231, 232, 0.2); padding-left: 3rem; }
  }

  /* FORZAMOS tamaño exacto aquí */
  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px !important;  /* 3rem exacto */
    height: 48px !important; /* 3rem exacto */
    flex-shrink: 0;          /* Evita que se encoja */
    border-radius: 9999px;
    overflow: hidden;
    transition: all 0.3s;
    background-color: transparent;
  }

  .social-btn img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
  }

  .social-btn:hover {
    transform: scale(1.1);
    filter: brightness(0.9);
  }

  .footer-title { font-size: 1.125rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .footer-address { font-size: 0.875rem; line-height: 1.6; font-weight: 300; font-style: normal; color: rgba(255, 255, 255, 0.9); }
  .contact-item { display: flex; align-items: center; gap: 0.75rem; font-size: 0.875rem; }
  .contact-icon { width: 1.25rem; height: 1.25rem; opacity: 0.9; }
  .contact-link:hover { color: #E6E7E8; text-decoration: underline; }

  @media (max-width: 768px) {
    footer { text-align: center; }
    .footer-column-border { border-top: 1px solid rgba(230, 231, 232, 0.1); padding-top: 2rem; align-items: center; }
    .contact-item, .flex-col, .items-start { align-items: center; justify-content: center; }
    .footer-address { text-align: center; }
  }
</style>